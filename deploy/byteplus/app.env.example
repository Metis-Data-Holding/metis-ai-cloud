# 仅为键名模板。部署时在 ECS 的 /etc/metis-ai-cloud/app.env 写入真实值。
# 不要把服务器文件复制回仓库、日志或工单。
SQL_DSN=postgresql://metis:<server-generated-postgres-password>@postgres:5432/metis
REDIS_CONN_STRING=redis://:<server-generated-redis-password>@redis:6379/0
SESSION_SECRET=<server-generated-session-secret>
CRYPTO_SECRET=<server-generated-crypto-secret>
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://many-models.metisdata.ai
FRONTEND_BASE_URL=https://many-models.metisdata.ai
TRUSTED_PROXIES=<compose-network-cidr>
TZ=Asia/Shanghai
NODE_NAME=metis-ai-cloud-byteplus
ERROR_LOG_ENABLED=true
