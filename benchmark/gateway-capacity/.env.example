# 复制为同目录 .env.local，并设置 chmod 600。
# TARGET 是 many-models 的 Base URL；脚本会补上 /v1/chat/completions。
GATEWAY_CAPACITY_TARGET=https://your-many-models.example.com
GATEWAY_CAPACITY_MODEL=mock-sleep-1s
GATEWAY_CAPACITY_API_KEY=

# 正式压测前才设置；smoke 不需要此确认。
GATEWAY_CAPACITY_ALLOW_LOAD=

# 仅本机调试 HTTP 目标时设置为 1；公网测试保持为空。
GATEWAY_CAPACITY_ALLOW_HTTP_LOCAL=

# 可选参数。非流式/流式默认分别为 10/5 VU、30s、30s。
# GATEWAY_CAPACITY_VUS=10
# GATEWAY_CAPACITY_DURATION=30s
# GATEWAY_CAPACITY_TIMEOUT=30s

# 这些是与 ECS Mock Provider 部署保持一致的期望配置，运行器会写入 metadata。
# MOCK_DELAY_MS=1000
# MOCK_TTFT_MS=100
# MOCK_CHUNK_INTERVAL_MS=100
# MOCK_CHUNK_COUNT=4
